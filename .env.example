# Copy to .env and fill in values from the same Supabase project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# These are exposed to the browser. Use only the URL and publishable key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase Postgres session-pooler URL (database password, not an API key).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres

# Base URL used for staff invitation links; use http://localhost:3000 locally.
SITE_URL=http://localhost:5173

# Optional email for bun run db:seed; it must already exist in Supabase Auth.
ADMIN_EMAIL= rr07079332442@gmail.com
